{
  "name": "36-01-projectguidlinesandrequirements",
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node --watch --conditions development --env-file=.env.development.local src/app.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --env-file=.env.development.local dist/app.js"
  },
  "imports": {
    "#db": {
      "development": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "#models": {
      "development": "./src/models/index.ts",
      "default": "./dist/models/index.js"
    },
    "#routes": {
      "development": "./src/routes/index.ts",
      "default": "./dist/routes/index.js"
    }, 
    "#controllers": {
      "development": "./src/controllers/index.ts",
      "default": "./dist/controllers/index.js"
    },  
    "#middleware": {
      "development": "./src/middleware/index.ts",
      "default": "./dist/middleware/index.js"
    },  
    "#schemas": {
      "development": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    }      
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BMU6/36-01-PGAR.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/BMU6/36-01-PGAR/issues"
  },
  "homepage": "https://github.com/BMU6/36-01-PGAR#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "mongoose": "^9.9.5",
    "zod": "^4.5.4"
  }
}
